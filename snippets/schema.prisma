// R5: collect the minimum, record consent, enforce retention
model Application {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  education Json
  statement String   @db.Text
  consentAt DateTime            // when and what was consented to
  createdAt DateTime @default(now())
  expiresAt DateTime            // e.g. createdAt + 6 months

  @@index([expiresAt])
}
// Date of birth, gender and permanent address: collect at offer stage only.
